diff --git a/tests/api.test.mjs b/tests/api.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/api.test.mjs
@@ -0,0 +1,74 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+function apiHarness() {
+  const pending = [];
+  const context = vm.createContext({ Set, Error, encodeURIComponent, fetch: (url, options) =>
+    new Promise(resolve => pending.push({ url, options, resolve })) });
+  let source = fs.readFileSync(new URL('../src/api.js', import.meta.url), 'utf8')
+    .replace('import.meta.env?.VITE_API_URL', 'undefined').replaceAll('export ', '');
+  source += '\nglobalThis.api = { login, signup, clearAuthToken, getAuthToken, subscribeAuth, getAllBookings, getStudentBookings };';
+  vm.runInContext(source, context);
+  const reply = (status, value) => pending.shift().resolve({ status, ok: status < 400, json: async () => value });
+  const signIn = async () => {
+    const result = context.api.login('a@student.edu.ph', 'TestOnly123');
+    reply(200, { token: 'test-token', role: 'student', student: { id: 1 } });
+    await result;
+  };
+  return { api: context.api, pending, reply, signIn };
+}
+
+test('login publishes token; protected API sends it; logout clears it', async () => {
+  const h = apiHarness(); let changes = 0;
+  const unsubscribe = h.api.subscribeAuth(() => changes++);
+  await h.signIn();
+  const result = h.api.getAllBookings();
+  assert.equal(h.pending[0].options.headers.Authorization, 'Bearer test-token');
+  h.reply(200, []); await result;
+  h.api.clearAuthToken(); assert.equal(h.api.getAuthToken(), null);
+  assert.equal(changes, 2); unsubscribe();
+});
+test('protected 401 clears session and explains reauthentication', async () => {
+  const h = apiHarness(); await h.signIn();
+  const result = h.api.getAllBookings(); h.reply(401, {});
+  await assert.rejects(result, /session expired/i); assert.equal(h.api.getAuthToken(), null);
+});
+test('403 keeps the authenticated session and backend message', async () => {
+  const h = apiHarness(); await h.signIn();
+  const result = h.api.getAllBookings(); h.reply(403, { message: 'Faculty only' });
+  await assert.rejects(result, /Faculty only/); assert.equal(h.api.getAuthToken(), 'test-token');
+});
+test('invalid credentials do not create a session', async () => {
+  const h = apiHarness(); const result = h.api.login('x', 'wrong'); h.reply(401, { message: 'Invalid credentials' });
+  await assert.rejects(result, /Invalid credentials/); assert.equal(h.api.getAuthToken(), null);
+});
+test('malformed successful auth response cannot establish a session', async () => {
+  const h = apiHarness(); const result = h.api.login('x', 'wrong');
+  h.reply(200, { role: 'faculty', faculty: { id: 1 } });
+  await assert.rejects(result, /Invalid login response/); assert.equal(h.api.getAuthToken(), null);
+});
+test('late login response cannot restore a logged-out session', async () => {
+  const h = apiHarness(); const result = h.api.login('x', 'password');
+  h.api.clearAuthToken(); h.reply(200, { token: 'late', role: 'student', student: { id: 1 } });
+  await assert.rejects(result, /Session changed/); assert.equal(h.api.getAuthToken(), null);
+});
+test('late protected response cannot populate a logged-out dashboard', async () => {
+  const h = apiHarness(); await h.signIn(); const result = h.api.getAllBookings();
+  h.api.clearAuthToken(); h.reply(200, [{ id: 1 }]);
+  await assert.rejects(result, /Session changed/);
+});
+test('logout during JSON parsing also discards protected response', async () => {
+  const h = apiHarness(); await h.signIn(); const result = h.api.getAllBookings();
+  let finish;
+  h.pending.shift().resolve({ status: 200, ok: true, json: () => new Promise(resolve => { finish = resolve; }) });
+  await new Promise(resolve => setImmediate(resolve));
+  h.api.clearAuthToken(); finish([{ id: 1 }]);
+  await assert.rejects(result, /Session changed/);
+});
+test('server outage preserves session for retry', async () => {
+  const h = apiHarness(); await h.signIn(); const result = h.api.getAllBookings();
+  h.reply(503, { message: 'Try later' }); await assert.rejects(result, /Try later/);
+  assert.equal(h.api.getAuthToken(), 'test-token');
+});
diff --git a/tests/setup.test.mjs b/tests/setup.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/setup.test.mjs
@@ -0,0 +1,41 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+
+async function runSetup(failAt) {
+  const queries=[]; let released=false; let ended=false;
+  const client={
+    query: async sql => { queries.push(sql); if (failAt && sql.includes(failAt)) throw Object.assign(new Error('test failure'),{code:'TEST'}); },
+    release:()=>{released=true;}
+  };
+  class Pool { async connect(){return client;} async end(){ended=true;} }
+  const fakeProcess={exitCode:0};
+  const context=vm.createContext({
+    __dirname:'/backend', console:{log(){},error(){}}, process:{...fakeProcess,env:{}},
+    require:name=> name==='fs'?{readFileSync:file=>file.endsWith('base-schema.sql')?'BASE MIGRATION':'AUTH MIGRATION'}:
+      name==='path'?path:name==='dotenv'?{config(){}}:name==='pg'?{Pool}:null
+  });
+  const source=fs.readFileSync(new URL('../Backend/setup-auth.cjs',import.meta.url),'utf8');
+  await vm.runInContext(source,context);
+  return {queries,released,ended,exitCode:context.process.exitCode};
+}
+test('setup commits both migrations after schema checks and releases connection',async()=>{
+  const r=await runSetup();
+  assert.equal(r.queries[0],'BEGIN');
+  assert.deepEqual(r.queries.slice(1,3),['BASE MIGRATION','AUTH MIGRATION']);
+  assert.equal(r.queries.at(-1),'COMMIT');
+  assert.ok(r.queries.some(q=>q.includes('FROM bookings LIMIT 0')));
+  assert.ok(r.released && r.ended);assert.equal(r.exitCode,0);
+});
+test('migration failure rolls back without committing',async()=>{
+  const r=await runSetup('AUTH MIGRATION');
+  assert.equal(r.queries.at(-1),'ROLLBACK');assert.ok(!r.queries.includes('COMMIT'));
+  assert.ok(r.released && r.ended);assert.equal(r.exitCode,1);
+});
+test('incompatible existing schema rolls back before commit',async()=>{
+  const r=await runSetup('FROM faculty LIMIT 0');
+  assert.equal(r.queries.at(-1),'ROLLBACK');assert.ok(!r.queries.includes('COMMIT'));
+  assert.ok(r.released && r.ended);assert.equal(r.exitCode,1);
+});
