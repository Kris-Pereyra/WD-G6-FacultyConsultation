+const fs = require('fs'), path = require('path');
+async function main() {
+  require('dotenv').config({ path: path.join(__dirname, '.env') });
+  const { Pool } = require('pg');
+  const pool = new Pool({ user: process.env.DB_USER, host: process.env.DB_HOST,
+    database: process.env.DB_NAME, password: process.env.DB_PASSWORD, port: Number(process.env.DB_PORT) || 5432 });
+  let client;
+  try {
+    client = await pool.connect();
+    await client.query('BEGIN');
+    for (const file of ['base-schema.sql', 'faculty-auth.sql']) {
+      await client.query(fs.readFileSync(path.join(__dirname, file), 'utf8'));
+    }
+    // Check all columns used by the API before committing changes.
+    await client.query('SELECT id,full_name,student_id,email,phone,program,year_level,password_hash,role FROM students LIMIT 0');
+    await client.query('SELECT id,name,department,room,available_days,start_minutes,end_minutes FROM faculty LIMIT 0');
+    await client.query('SELECT id,student_id,faculty_id,date_key,time_slot,subject,status FROM bookings LIMIT 0');
+    await client.query('COMMIT');
+    console.log('Database setup complete. Existing records were retained.');
+  } catch (error) {
+    if (client) await client.query('ROLLBACK');
+    console.error('Setup failed; changes rolled back. Review existing schema/duplicates. Code:', error.code || 'unknown');
+    process.exitCode = 1;
+  } finally { if (client) client.release(); await pool.end(); }
 }
